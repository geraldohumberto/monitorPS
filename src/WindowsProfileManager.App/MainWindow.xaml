<Window x:Class="WindowsProfileManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Perfil Windows - Controle de Processos e Servicos"
        Width="1280"
        Height="820"
        MinWidth="980"
        MinHeight="640">
    <DockPanel Background="#F4F6F8">
        <Border DockPanel.Dock="Top" Background="#17202A" Padding="14">
            <TextBlock Text="Perfil Windows - Controle de Processos e Servicos"
                       Foreground="White"
                       FontSize="20"
                       FontWeight="SemiBold"/>
        </Border>

        <Border DockPanel.Dock="Top" Background="#FFFFFF" Padding="10">
            <StackPanel>
                <WrapPanel>
                    <Button Content="Varrer este PC" Command="{Binding ScanCommand}"/>
                    <Button Content="Salvar verificacao" Command="{Binding SaveProfileCommand}"/>
                    <Button Content="Carregar arquivo" Command="{Binding LoadProfileCommand}"/>
                    <Button Content="Comparar" Command="{Binding CompareCommand}"/>
                    <Button Content="Aplicar acoes pendentes" Command="{Binding ApplyPendingCommand}"/>
                    <Button Content="Reiniciar como admin" Command="{Binding RestartAsAdminCommand}"/>
                </WrapPanel>
                <Grid Margin="4,8,4,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding LoadedProfileName, StringFormat=Perfil carregado: {0}}"/>
                    <TextBlock Grid.Column="1" Text="{Binding AdminStatus}" HorizontalAlignment="Right"/>
                </Grid>
                <TextBlock Margin="4,5,4,0">
                    <Run Text="Status: "/>
                    <Run Text="{Binding Summary.ProcessCount}"/>
                    <Run Text=" processos | "/>
                    <Run Text="{Binding Summary.RunningServicesCount}"/>
                    <Run Text=" servicos rodando | "/>
                    <Run Text="{Binding Summary.StartupCount}"/>
                    <Run Text=" inicializacao | "/>
                    <Run Text="{Binding Summary.ExtrasCount}"/>
                    <Run Text=" extras | "/>
                    <Run Text="{Binding Summary.PendingCount}"/>
                    <Run Text=" acoes pendentes"/>
                </TextBlock>
                <TextBlock Margin="4,5,4,0" Text="{Binding ScanStatusText}" Foreground="#566573"/>
            </StackPanel>
        </Border>

        <TabControl Margin="10">
            <TabItem Header="Visao Geral">
                <UniformGrid Columns="3" Rows="2" Margin="12">
                    <Border Background="White" Margin="6" Padding="16" BorderBrush="#D9DEE4" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Processos ativos" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Summary.ProcessCount}" FontSize="30"/>
                        </StackPanel>
                    </Border>
                    <Border Background="White" Margin="6" Padding="16" BorderBrush="#D9DEE4" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Servicos rodando" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Summary.RunningServicesCount}" FontSize="30"/>
                        </StackPanel>
                    </Border>
                    <Border Background="White" Margin="6" Padding="16" BorderBrush="#D9DEE4" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Inicializacao" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Summary.StartupCount}" FontSize="30"/>
                        </StackPanel>
                    </Border>
                    <Border Background="White" Margin="6" Padding="16" BorderBrush="#D9DEE4" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Extras" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Summary.ExtrasCount}" FontSize="30"/>
                        </StackPanel>
                    </Border>
                    <Border Background="White" Margin="6" Padding="16" BorderBrush="#D9DEE4" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Protegidos" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Summary.ProtectedCount}" FontSize="30"/>
                        </StackPanel>
                    </Border>
                    <Border Background="White" Margin="6" Padding="16" BorderBrush="#D9DEE4" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Acoes pendentes" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Summary.PendingCount}" FontSize="30"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>
            </TabItem>

            <TabItem Header="Processos">
                <DockPanel Margin="8">
                    <WrapPanel DockPanel.Dock="Top">
                        <Button Content="Encerrar Agora" Command="{Binding KillNowCommand}"/>
                        <Button Content="Adicionar para Encerrar" Command="{Binding QueueKillCommand}"/>
                        <Button Content="Adicionar aos Permitidos" Command="{Binding AddProcessAllowedCommand}"/>
                    </WrapPanel>
                    <DataGrid ItemsSource="{Binding Processes}">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Sel." Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="48"/>
                            <DataGridTextColumn Header="Nome" Binding="{Binding Name}" Width="180" IsReadOnly="True"/>
                            <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="80" IsReadOnly="True"/>
                            <DataGridTextColumn Header="CPU s" Binding="{Binding CpuSeconds, StringFormat=N1}" Width="80" IsReadOnly="True"/>
                            <DataGridTextColumn Header="RAM" Binding="{Binding RamDisplay}" Width="100" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Caminho" Binding="{Binding Path}" Width="*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Usuario" Binding="{Binding User}" Width="120" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Comparacao" Binding="{Binding ComparisonStatus}" Width="120" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Categoria" Binding="{Binding Category}" Width="120" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Servicos">
                <DockPanel Margin="8">
                    <WrapPanel DockPanel.Dock="Top">
                        <Button Content="Iniciar" Command="{Binding StartServiceCommand}"/>
                        <Button Content="Parar" Command="{Binding StopServiceCommand}"/>
                        <Button Content="Reiniciar" Command="{Binding RestartServiceCommand}"/>
                        <Button Content="Automatico" Command="{Binding SetAutomaticCommand}"/>
                        <Button Content="Manual" Command="{Binding SetManualCommand}"/>
                        <Button Content="Desativado" Command="{Binding DisableServiceCommand}"/>
                        <Button Content="Adicionar aos Permitidos" Command="{Binding AddServiceAllowedCommand}"/>
                        <Button Content="Marcar para Desativar" Command="{Binding QueueDisableServiceCommand}"/>
                        <Button Content="Marcar como Manual" Command="{Binding QueueManualServiceCommand}"/>
                    </WrapPanel>
                    <DataGrid ItemsSource="{Binding Services}">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Sel." Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="48"/>
                            <DataGridTextColumn Header="Nome interno" Binding="{Binding Name}" Width="160" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Exibicao" Binding="{Binding DisplayName}" Width="240" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="150" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Inicializacao" Binding="{Binding StartupType}" Width="120" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Executavel" Binding="{Binding ExecutablePath}" Width="*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Comparacao" Binding="{Binding ComparisonStatus}" Width="120" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Categoria" Binding="{Binding Category}" Width="110" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Inicializacao">
                <DockPanel Margin="8">
                    <WrapPanel DockPanel.Dock="Top">
                        <Button Content="Desativar" Command="{Binding DisableStartupCommand}"/>
                        <Button Content="Adicionar aos Permitidos" Command="{Binding AddStartupAllowedCommand}"/>
                        <Button Content="Marcar para Desativar" Command="{Binding QueueDisableStartupCommand}"/>
                    </WrapPanel>
                    <DataGrid ItemsSource="{Binding StartupItems}">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Sel." Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="48"/>
                            <DataGridTextColumn Header="Nome" Binding="{Binding Name}" Width="220" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Fonte" Binding="{Binding Source}" Width="160" IsReadOnly="True"/>
                            <DataGridCheckBoxColumn Header="Ativo" Binding="{Binding Enabled}" Width="70" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Comando" Binding="{Binding Command}" Width="*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Comparacao" Binding="{Binding ComparisonStatus}" Width="120" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Categoria" Binding="{Binding Category}" Width="120" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Comparativo">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <GroupBox Header="Permitidos no Perfil" Margin="4">
                        <ListBox ItemsSource="{Binding Comparison.AllowedProcesses}" DisplayMemberPath="Name"/>
                    </GroupBox>
                    <GroupBox Grid.Column="1" Header="Extras Neste PC" Margin="4">
                        <ListBox ItemsSource="{Binding Comparison.ExtraProcesses}" DisplayMemberPath="Name"/>
                    </GroupBox>
                    <GroupBox Grid.Column="2" Header="Protegidos" Margin="4">
                        <ListBox ItemsSource="{Binding Comparison.ProtectedProcesses}" DisplayMemberPath="Name"/>
                    </GroupBox>
                </Grid>
            </TabItem>

            <TabItem Header="Acoes Pendentes">
                <DockPanel Margin="8">
                    <WrapPanel DockPanel.Dock="Top">
                        <Button Content="Remover selecionados" Command="{Binding RemovePendingCommand}"/>
                        <Button Content="Limpar tudo" Command="{Binding ClearPendingCommand}"/>
                        <Button Content="Aplicar acoes pendentes" Command="{Binding ApplyPendingCommand}"/>
                        <Button Content="Salvar acoes como arquivo" Command="{Binding SavePendingCommand}"/>
                    </WrapPanel>
                    <DataGrid ItemsSource="{Binding PendingActions}">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Sel." Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="48"/>
                            <DataGridTextColumn Header="Tipo" Binding="{Binding Type}" Width="160" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Alvo" Binding="{Binding TargetName}" Width="240" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Descricao" Binding="{Binding Description}" Width="*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="220" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Relatorio">
                <DockPanel Margin="8">
                    <WrapPanel DockPanel.Dock="Top">
                        <Button Content="Salvar verificacao .json" Command="{Binding SaveProfileCommand}"/>
                        <Button Content="Exportar relatorio .txt" Command="{Binding ExportReportCommand}"/>
                        <Button Content="Carregar .json" Command="{Binding LoadProfileCommand}"/>
                    </WrapPanel>
                    <TextBox Text="{Binding ReportText}" FontFamily="Consolas" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
